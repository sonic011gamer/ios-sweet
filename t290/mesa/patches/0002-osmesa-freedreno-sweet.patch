 #include "sw/null/null_sw_winsys.h"
 
+#ifdef T290_SWEET
+/* SM-T290 iPadOS: Freedreno on the SweetGPU user client (t290/mesa) */
+#include <stdio.h>
+#include <stdlib.h>
+#include "util/driconf.h"
+#include "util/xmlconfig.h"
+#include "util/u_math.h"
