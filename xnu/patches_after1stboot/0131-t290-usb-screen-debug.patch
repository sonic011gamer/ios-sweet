+    ++u.errors;
+    return false;
+}
+static void sleep_ms(unsigned ms)
+{
+    assert_wait_timeout((event_t)&u, THREAD_UNINT, ms, NSEC_PER_MSEC);
+    thread_block(THREAD_CONTINUE_NULL);
