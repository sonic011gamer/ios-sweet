+static bool ulpi_write(uint8_t reg, uint8_t value)
+{
+    wr(u.core, 0x170, (1u << 30) | (1u << 29) | ((uint32_t)reg << 16) | value);
+    return wait_clear(u.core, 0x170, 1u << 30, 10000);
