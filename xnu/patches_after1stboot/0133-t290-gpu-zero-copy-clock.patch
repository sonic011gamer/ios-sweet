 IOReturn
+SweetGPUUserClient::prepare(const uint32_t *handles, uint32_t n)
+{
+	IOLockLock(fLock);
+	fListMode = true;
+	for (uint32_t k = 0; k < n; k++) {
+		uint32_t i = handles[k] - 1;
+		if (handles[k] == 0 || i >= SWEET_GPU_MAX_BUFFERS || fBuf[i].md == NULL ||
+		    fBuf[i].kva == 0 || fBuf[i].pending == PENDING_NEXT) {
+			continue;
+		}
+		FlushPoC_DcacheRegion(fBuf[i].kva, (size_t)fBuf[i].size);
+		fBuf[i].pending = PENDING_NEXT;
+		if (fNumPrepared < MAX_PREPARED) {
+			fPrepared[fNumPrepared++] = i;
+		}
+	}
+	IOLockUnlock(fLock);
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::submitted(uint32_t seq)
+{
+	IOLockLock(fLock);
+	for (uint32_t k = 0; k < fNumPrepared; k++) {
+		if (fBuf[fPrepared[k]].pending == PENDING_NEXT) {
+			fBuf[fPrepared[k]].pending = seq;
+		}
+	}
+	fNumPrepared = 0;
+	IOLockUnlock(fLock);
+}
+
+/* GPU writes of finished submits: drop the CPU's stale lines */
+void
+SweetGPUUserClient::completed(uint32_t seq)
+{
+	IOLockLock(fLock);
+	for (uint32_t i = 0; i < SWEET_GPU_MAX_BUFFERS; i++) {
+		uint32_t p = fBuf[i].pending;
+		if (p != 0 && p != PENDING_NEXT && (int32_t)(p - seq) <= 0) {
+			if (fBuf[i].md != NULL && fBuf[i].kva != 0) {
+				FlushPoC_DcacheRegion(fBuf[i].kva, (size_t)fBuf[i].size);
+			}
+			fBuf[i].pending = 0;
+		}
+	}
+	IOLockUnlock(fLock);
+}
