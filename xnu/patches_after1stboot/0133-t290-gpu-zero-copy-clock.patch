+/*
+ * gfx3d_clk_src: source GPLL0 (CFG bits 8-10 = 1), half-integer divider
+ * HID = 2 * div - 1 (bits 0-4); CMD bit 0 latches the new configuration.
+ * The caller has voted the CX corner the frequency needs (Android's kgsl:
+ * 400 MHz at SVS_PLUS); the GPU must be idle.
+ */
+uint32_t
+sweet_gpu_set_clock(uint32_t mhz)
+{
+	uint32_t div = mhz >= 400 ? 2 : 4;
+	if (!gpu_up || gpu_gcc == 0) {
+		return gpu_mhz;
+	}
+	IOLockLock(gpu_lock);
+	volatile uint32_t *rcg = (volatile uint32_t *)gpu_gcc;
+	uint32_t before = rcg[1];
+	rcg[1] = (before & ~0x71fu) | (1u << 8) | (2 * div - 1);
+	rcg[0] |= 1;
+	int i;
+	for (i = 0; i < 1000 && (rcg[0] & 1); i++) {
+		delay(1);
+	}
+	if (rcg[0] & 1) {
+		rcg[1] = before;                /* not latched: keep the old clock */
+		rcg[0] |= 1;
+	} else {
+		gpu_mhz = 800 / div;
+	}
+	IOLockUnlock(gpu_lock);
+	printf("SWEET GPU: core clock %u MHz (gfx3d cfg %#x -> %#x, cmd %#x)\n",
+	    gpu_mhz, before, rcg[1], rcg[0]);
+	return gpu_mhz;
+}
