+/*
+ * A voltage level (corner) vote for an RPM SMPS, e.g. pm8953 S2 = VDD_CX,
+ * which also feeds the GPU: sweet_t290_rpm_level(2, 256) = NOM.
+ * Levels as Linux RPM_REGULATOR_LEVEL_*: SVS 128, SVS_PLUS 192, NOM 256,
+ * NOM_PLUS 320, TURBO 384. 0 or errno.
+ */
+#define RPM_SMPA                0x61706d73      /* "smpa" */
+#define RPM_KEY_VLVL            0x6c766c76      /* "vlvl" */
+int sweet_t290_rpm_level(uint32_t smps, uint32_t level);
+
+int
+sweet_t290_rpm_level(uint32_t smps, uint32_t level)
+{
+	const uint32_t kv[] = { RPM_KEY_VLVL, level };
+	if (!sd.ready || !sd.smd_tx) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_sdhc_lock);
+	uint32_t got = rpm_req(RPM_SMPA, smps, kv, 1);
+	lck_mtx_unlock(&sweet_sdhc_lock);
+	return got ? 0 : EIO;
+}
