+extern "C" int sweet_t290_rpm_level(uint32_t smps, uint32_t level);
+
+/*
+ * The shim starts the GPU at 200 MHz. At the first client (root is mounted,
+ * so the SD driver's RPM channel is open) vote VDD_CX (pm8953 S2, which
+ * also feeds the GPU) to NOM and switch to 400 MHz (Android: 400 MHz at
+ * SVS_PLUS). Boot-arg t290gpu_mhz=200 keeps the shim's clock.
+ */
+void
+SweetGPU::raiseClock(void)
+{
+	static bool done;
+	if (done || !sweet_gpu_ready()) {
+		return;
+	}
+	done = true;
+	uint32_t mhz = 400;
+	PE_parse_boot_argn("t290gpu_mhz", &mhz, sizeof(mhz));
+	if (mhz <= 200) {
+		return;
+	}
+	int e = sweet_t290_rpm_level(2, 256);
+	if (e != 0) {
+		printf("SWEET GPU: VDD_CX vote failed (%d), GPU stays at 200 MHz\n", e);
+		return;
+	}
+	sweet_gpu_set_clock(mhz);
+}
