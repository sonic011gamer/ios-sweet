@@ -59,7 +59,8 @@ extern "C" void flush_dcache64(addr64_t addr, unsigned count, int phys);
  * SM-T290: LK leaves an 800x1280 RGB888 splash (bytes R,B,G) that the panel
  * scans out shifted right with wrap-around (t290/shim/diag.c). The GUI draws
  * into a 1536x2048 BGRA shadow, the iPad 5 panel; each flush halves it and
- * centres the 768x1024 result on the panel.
+ * centres the 768x1024 result on the panel. With t290native=1 the shadow is
+ * the panel's own 800x1280 (@1x in the ADT) and each flush copies it 1:1.
  */
 #define T290_SHADOW_W   1536u
 #define T290_SHADOW_H   2048u
@@ -136,6 +137,8 @@ public:
 	uintptr_t     fPanel;         /* write-combined mapping of the splash */
 	uint32_t      fPanelW, fPanelH, fPanelRow, fPanelShift;
 	bool          fPanelCleared;
