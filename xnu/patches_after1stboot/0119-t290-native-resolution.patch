@@ -486,6 +497,29 @@ AppleCLCD::t290Setup(void)
 void
 AppleCLCD::t290Panel(void)
 {
+	if (fNative) {
+		/*
+		 * 1:1. Screen x >= shift lives at buffer x - shift on the same row,
+		 * screen x < shift wraps to the end of the row above: two runs.
+		 */
+		uint32_t n = fPanelW * 3, sh = fPanelShift * 3;
+		for (uint32_t y = 0; y < fPanelH; y++) {
+			const uint32_t *src = (const uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+			uint8_t *t = fRowBuf;
+			for (uint32_t x = 0; x < fPanelW; x++, t += 3) {
+				uint32_t v = src[x];
+				t[0] = (uint8_t)(v >> 16);      /* R */
+				t[1] = (uint8_t)v;              /* B */
+				t[2] = (uint8_t)(v >> 8);       /* G */
+			}
+			uint8_t *row = (uint8_t *)(fPanel + (uint64_t)y * fPanelRow);
+			bcopy(fRowBuf + sh, row, n - sh);
+			if (y > 0 && sh != 0) {
+				bcopy(fRowBuf, row - fPanelRow + (n - sh), sh);
+			}
+		}
+		return;
+	}
 	uint32_t outW = fWidth / 2, outH = fHeight / 2;
 	uint32_t ox = (fPanelW - outW) / 2, oy = (fPanelH - outH) / 2;
 
