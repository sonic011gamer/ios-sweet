diff --git a/bsd/dev/sweet_t290_gpu.h b/bsd/dev/sweet_t290_gpu.h
new file mode 100755
index 0000000..efaf9d1
--- /dev/null
+++ b/bsd/dev/sweet_t290_gpu.h
@@ -0,0 +1,33 @@
+/*
+ * SWEET_BOARD=t290: Adreno 504 kernel interface (bsd/dev/sweet_t290_gpu.c),
+ * used by the SweetGPU user client (iokit/Kernel/arm/SweetGPU.cpp).
+ *
+ * GPU virtual addresses: the SMMU context bank the shim set up maps DRAM
+ * 0x80000000-0xffffffff 1:1 (kernel use); 0x10000000-0x7fffffff is a window
+ * of 4 KiB pages mapped here for user buffers (64 KiB granules).
+ */
+#ifndef SWEET_T290_GPU_H
+#define SWEET_T290_GPU_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define SWEET_GPU_CHIP_ID       0x05000400u     /* Adreno 504 */
+#define SWEET_GPU_GMEM_SIZE     0x22000u        /* kgsl: gmem 0x22000 at 0x100000 */
+
+int      sweet_gpu_ready(void);
+/* reserve a GPU VA range of size bytes (64 KiB granules); 0 on failure */
+uint64_t sweet_gpu_va_alloc(uint64_t size);
+void     sweet_gpu_va_free(uint64_t va, uint64_t size);
+/* map/unmap physically contiguous pa..pa+size at va (4 KiB aligned) */
+int      sweet_gpu_map(uint64_t va, uint64_t pa, uint64_t size);
+void     sweet_gpu_unmap(uint64_t va, uint64_t size);
+/* run an indirect buffer; returns its fence sequence number (0: failed) */
+uint32_t sweet_gpu_submit(uint64_t ib_va, uint32_t dwords);
+/* wait until fence seq passed; 0 ok, -1 timeout */
+int      sweet_gpu_wait(uint32_t seq, uint32_t timeout_ms);
+uint32_t sweet_gpu_fence(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/SweetGPU.cpp b/iokit/Kernel/arm/SweetGPU.cpp
new file mode 100755
index 0000000..c7d739a
--- /dev/null
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -0,0 +1,273 @@
+/*
+ * SWEET_BOARD=t290: SweetGPU, the user-space interface to the Adreno 504
+ * (kgsl-like, for a Mesa Freedreno winsys). Built-in personality on
+ * IOResources; the hardware side is bsd/dev/sweet_t290_gpu.c.
+ *
+ * IOServiceOpen(SweetGPU, type 0) -> SweetGPUUserClient, scalar selectors:
+ *   0 GetInfo  -> [chip id, gmem size, ready, user window base]
+ *   1 Alloc    [size] -> [handle, gpu address, size]   (write-combined)
+ *   2 Free     [handle]
+ *   3 Submit   [ib gpu address, dwords] -> [fence seq]
+ *   4 Wait     [seq, timeout ms]           (kIOReturnTimeout)
+ *   5 Fence    -> [last completed seq]
+ * IOConnectMapMemory64(conn, handle, ...) maps a buffer into the task.
+ * Buffers are freed with the client; waiting for the GPU before Free is
+ * the caller's job.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(SWEET_T290)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSArray.h>
+#include "../../../bsd/dev/sweet_t290_gpu.h"
+
+#define SWEET_GPU_MAX_BUFFERS   4096
+
+class SweetGPU : public IOService {
+	OSDeclareDefaultStructors(SweetGPU);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(SweetGPU, IOService);
+
+class SweetGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetGPUUserClient);
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+private:
+	struct Buffer {
+		IOBufferMemoryDescriptor *md;
+		uint64_t gpuaddr, size;
+	};
+	Buffer *fBuf;
+	IOLock *fLock;
+	IOReturn alloc(uint64_t size, uint64_t *out);
+	void release_buffer(uint32_t i);
+};
+OSDefineMetaClassAndStructors(SweetGPUUserClient, IOUserClient);
+
+bool
+SweetGPU::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("SWEET GPU: SweetGPU service registered\n");
+	return true;
+}
+
+IOReturn
+SweetGPU::newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler)
+{
+	SweetGPUUserClient *uc = OSTypeAlloc(SweetGPUUserClient);
+	if (uc == NULL || !uc->initWithTask(owningTask, securityID, type) || !uc->attach(this) ||
+	    !uc->start(this)) {
+		if (uc != NULL) {
+			uc->detach(this);
+			uc->release();
+		}
+		return kIOReturnNoMemory;
+	}
+	*handler = uc;
+	return kIOReturnSuccess;
+}
+
+bool
+SweetGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fLock = IOLockAlloc();
+	fBuf = IONew(Buffer, SWEET_GPU_MAX_BUFFERS);
+	if (fLock == NULL || fBuf == NULL) {
+		return false;
+	}
+	bzero(fBuf, sizeof(Buffer) * SWEET_GPU_MAX_BUFFERS);
+	return true;
+}
+
+void
+SweetGPUUserClient::release_buffer(uint32_t i)
+{
+	if (fBuf[i].md == NULL) {
+		return;
+	}
+	sweet_gpu_unmap(fBuf[i].gpuaddr, fBuf[i].size);
+	sweet_gpu_va_free(fBuf[i].gpuaddr, fBuf[i].size);
+	fBuf[i].md->release();
+	fBuf[i].md = NULL;
+}
+
+IOReturn
+SweetGPUUserClient::clientClose(void)
+{
+	if (fBuf != NULL) {
+		IOLockLock(fLock);
+		for (uint32_t i = 0; i < SWEET_GPU_MAX_BUFFERS; i++) {
+			release_buffer(i);
+		}
+		IOLockUnlock(fLock);
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::free(void)
+{
+	if (fBuf != NULL) {
+		IODelete(fBuf, Buffer, SWEET_GPU_MAX_BUFFERS);
+		fBuf = NULL;
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+SweetGPUUserClient::alloc(uint64_t size, uint64_t *out)
+{
+	size = (size + 0xfff) & ~0xfffULL;
+	if (size == 0 || size > 256ULL << 20) {
+		return kIOReturnBadArgument;
+	}
+	IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache, size, 4096);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	bzero(md->getBytesNoCopy(), size);
+	uint64_t va = sweet_gpu_va_alloc(size);
+	if (va == 0) {
+		md->release();
+		return kIOReturnNoSpace;
+	}
+	for (uint64_t off = 0; off < size;) {
+		IOByteCount len = 0;
+		addr64_t pa = md->getPhysicalSegment(off, &len, kIOMemoryMapperNone);
+		if (pa == 0 || len == 0) {
+			sweet_gpu_unmap(va, off);
+			sweet_gpu_va_free(va, size);
+			md->release();
+			return kIOReturnVMError;
+		}
+		if (len > size - off) {
+			len = size - off;
+		}
+		sweet_gpu_map(va + off, pa, len);
+		off += len;
+	}
+	IOLockLock(fLock);
+	for (uint32_t i = 0; i < SWEET_GPU_MAX_BUFFERS; i++) {
+		if (fBuf[i].md == NULL) {
+			fBuf[i].md = md;
+			fBuf[i].gpuaddr = va;
+			fBuf[i].size = size;
+			IOLockUnlock(fLock);
+			out[0] = i + 1;
+			out[1] = va;
+			out[2] = size;
+			return kIOReturnSuccess;
+		}
+	}
+	IOLockUnlock(fLock);
+	sweet_gpu_unmap(va, size);
+	sweet_gpu_va_free(va, size);
+	md->release();
+	return kIOReturnNoResources;
+}
+
+IOReturn
+SweetGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	uint64_t out[4] = { 0, 0, 0, 0 };
+	uint32_t outCount = 0;
+	IOReturn ret = kIOReturnSuccess;
+	const uint64_t *in = args->scalarInput;
+	uint32_t nin = args->scalarInputCount;
+
+	if (selector != 0 && !sweet_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	switch (selector) {
+	case 0:
+		out[0] = SWEET_GPU_CHIP_ID;
+		out[1] = SWEET_GPU_GMEM_SIZE;
+		out[2] = (uint64_t)sweet_gpu_ready();
+		out[3] = 0x10000000;
+		outCount = 4;
+		break;
+	case 1:
+		ret = nin >= 1 ? alloc(in[0], out) : kIOReturnBadArgument;
+		outCount = 3;
+		break;
+	case 2:
+		if (nin < 1 || in[0] == 0 || in[0] > SWEET_GPU_MAX_BUFFERS) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		IOLockLock(fLock);
+		release_buffer((uint32_t)in[0] - 1);
+		IOLockUnlock(fLock);
+		break;
+	case 3:
+		if (nin < 2) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		out[0] = sweet_gpu_submit(in[0], (uint32_t)in[1]);
+		ret = out[0] ? kIOReturnSuccess : kIOReturnError;
+		outCount = 1;
+		break;
+	case 4:
+		ret = nin < 2 ? kIOReturnBadArgument :
+		    (sweet_gpu_wait((uint32_t)in[0], (uint32_t)in[1]) == 0 ? kIOReturnSuccess : kIOReturnTimeout);
+		break;
+	case 5:
+		out[0] = sweet_gpu_fence();
+		outCount = 1;
+		break;
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = i < outCount ? out[i] : 0;
+	}
+	return ret;
+}
+
+IOReturn
+SweetGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	if (type == 0 || type > SWEET_GPU_MAX_BUFFERS) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	IOBufferMemoryDescriptor *md = fBuf[type - 1].md;
+	if (md != NULL) {
+		md->retain();
+	}
+	IOLockUnlock(fLock);
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	*options = 0;
+	*memory = md;
+	return kIOReturnSuccess;
+}
