+static void
+ring_kick(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gpu_wr(CP_RB_WPTR, ring_wptr);
+}
+
+int
+sweet_gpu_ready(void)
+{
+	return gpu_up;
+}
+
+uint32_t
+sweet_gpu_fence(void)
+{
+	return gpu_up ? *gpu_fence_cpu : 0;
+}
+
+static void
+smmu_flush(void)
+{
+	volatile uint32_t *cb = (volatile uint32_t *)gpu_cb;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	cb[CB_TLBIALL / 4] = 0;
+	cb[CB_TLBSYNC / 4] = 0;
+	for (int i = 0; i < 1000 && (cb[CB_TLBSTATUS / 4] & 1); i++) {
+		delay(1);
+	}
+}
+
+/* a zeroed, physically contiguous 4 KiB page for a translation table */
+static uint64_t *
+table_page(uint64_t *pa)
+{
+	uint64_t *t = (uint64_t *)IOMallocAligned(4096, 4096);
+	if (t == NULL) {
+		return NULL;
+	}
+	bzero(t, 4096);
+	*pa = kvtophys((vm_offset_t)t);
+	flush_dcache64((addr64_t)*pa, 4096, TRUE);
+	return t;
+}
+
+uint64_t
+sweet_gpu_va_alloc(uint64_t size)
+{
+	uint64_t n = (size + GRANULE - 1) / GRANULE, run = 0;
+	if (!gpu_up || n == 0 || n > NGRANULES) {
+		return 0;
+	}
+	IOLockLock(gpu_lock);
+	for (uint64_t g = 0; g < NGRANULES; g++) {
+		run = (va_used[g / 8] & (1u << (g % 8))) ? 0 : run + 1;
+		if (run == n) {
+			for (uint64_t k = g + 1 - n; k <= g; k++) {
+				va_used[k / 8] |= (uint8_t)(1u << (k % 8));
+			}
+			IOLockUnlock(gpu_lock);
+			return WIN_BASE + (g + 1 - n) * GRANULE;
+		}
+	}
+	IOLockUnlock(gpu_lock);
+	return 0;
+}
+
+void
+sweet_gpu_va_free(uint64_t va, uint64_t size)
+{
+	if (va < WIN_BASE || va >= WIN_END) {
+		return;
+	}
+	IOLockLock(gpu_lock);
+	for (uint64_t g = (va - WIN_BASE) / GRANULE, n = (size + GRANULE - 1) / GRANULE; n--; g++) {
+		va_used[g / 8] &= (uint8_t)~(1u << (g % 8));
+	}
+	IOLockUnlock(gpu_lock);
+}
+
+int
+sweet_gpu_map(uint64_t va, uint64_t pa, uint64_t size)
+{
+	if (!gpu_up || (va & 0xfff) || (pa & 0xfff) || va < WIN_BASE || va + size > WIN_END) {
+		return -1;
+	}
+	IOLockLock(gpu_lock);
+	for (uint64_t off = 0; off < size; off += 4096) {
+		uint64_t v = va + off;
+		unsigned i2 = (unsigned)(v >> 21);              /* 2 MiB slot in 0-2 GiB */
+		if (l3[i2] == NULL) {
+			l3[i2] = table_page(&l3_pa[i2]);
+			if (l3[i2] == NULL) {
+				IOLockUnlock(gpu_lock);
+				return -1;
+			}
+			l2[i2 >> 9][i2 & 511] = l3_pa[i2] | 3;
+			flush_dcache64((addr64_t)(l2_pa[i2 >> 9] + 8 * (i2 & 511)), 8, TRUE);
+		}
+		/* page | AttrIdx 0 (MAIR0 0x44, normal non-cacheable) | AP[1] | AF, SH 0 */
+		l3[i2][(v >> 12) & 511] = (pa + off) | 1ULL << 10 | 1ULL << 6 | 3;
+		flush_dcache64((addr64_t)(l3_pa[i2] + 8 * ((v >> 12) & 511)), 8, TRUE);
+	}
+	smmu_flush();
+	IOLockUnlock(gpu_lock);
+	return 0;
+}
+
+void
+sweet_gpu_unmap(uint64_t va, uint64_t size)
+{
+	if (!gpu_up || va < WIN_BASE || va + size > WIN_END) {
+		return;
+	}
+	IOLockLock(gpu_lock);
+	for (uint64_t off = 0; off < size; off += 4096) {
+		uint64_t v = va + off;
+		unsigned i2 = (unsigned)(v >> 21);
+		if (l3[i2] != NULL) {
+			l3[i2][(v >> 12) & 511] = 0;
+			flush_dcache64((addr64_t)(l3_pa[i2] + 8 * ((v >> 12) & 511)), 8, TRUE);
+		}
+	}
+	smmu_flush();
+	IOLockUnlock(gpu_lock);
+}
+
+uint32_t
+sweet_gpu_submit(uint64_t ib_va, uint32_t dwords)
+{
+	if (!gpu_up || dwords == 0 || dwords > 0xfffff) {
+		return 0;
+	}
+	IOLockLock(gpu_lock);
+	if (!ring_room(4 + 5)) {
+		IOLockUnlock(gpu_lock);
+		return 0;
+	}
+	uint32_t seq = ++fence_seq;
+	ring_out(pkt7(CP_INDIRECT_BUFFER_PFE, 3));
+	ring_out((uint32_t)ib_va);
+	ring_out((uint32_t)(ib_va >> 32));
+	ring_out(dwords);
+	ring_out(pkt7(CP_EVENT_WRITE, 4));
+	ring_out(CACHE_FLUSH_TS);
+	ring_out(fence_pa);
+	ring_out(0);
+	ring_out(seq);
+	ring_kick();
+	IOLockUnlock(gpu_lock);
+	return seq;
+}
+
+int
+sweet_gpu_wait(uint32_t seq, uint32_t timeout_ms)
+{
+	if (!gpu_up) {
+		return -1;
+	}
+	for (uint32_t us = 0; (int32_t)(*gpu_fence_cpu - seq) < 0; us += 50) {
+		if (us >= timeout_ms * 1000) {
+			return -1;
+		}
+		delay(50);
+	}
+	return 0;
+}
+
+/* boot self-test: a kernel IB in the user window writes a marker through the window */
+static void
+gpu_selftest(void)
+{
+	uint32_t *page = (uint32_t *)IOMallocAligned(8192, 4096);
+	if (page == NULL) {
+		return;
+	}
+	uint64_t pa0 = kvtophys((vm_offset_t)page), pa1 = kvtophys((vm_offset_t)page + 4096);
+	uint64_t va = sweet_gpu_va_alloc(8192);
+	if (va == 0 || sweet_gpu_map(va, pa0, 4096) || sweet_gpu_map(va + 4096, pa1, 4096)) {
+		printf("SWEET GPU: self-test could not map (va %#llx)\n", va);
+		return;
+	}
+	uint32_t *ib = page, *target = page + 1024;     /* second page */
+	target[0] = 0;
+	unsigned n = 0;
+	ib[n++] = pkt7(CP_MEM_WRITE, 3);
+	ib[n++] = (uint32_t)(va + 4096);
+	ib[n++] = (uint32_t)((va + 4096) >> 32);
+	ib[n++] = 0x5a5aa5a5;
+	flush_dcache64((addr64_t)pa0, 4096, TRUE);
+	flush_dcache64((addr64_t)pa1, 4096, TRUE);
+	uint64_t t0 = mach_absolute_time(), ns;
+	uint32_t seq = sweet_gpu_submit(va, n);
+	int w = seq ? sweet_gpu_wait(seq, 1000) : -1;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	flush_dcache64((addr64_t)pa1, 4096, TRUE);
+	printf("SWEET GPU: self-test IB at %#llx -> %s in %llu us (fence %u/%u, marker %#x)\n",
+	    va, w == 0 && target[0] == 0x5a5aa5a5 ? "OK" : "FAILED", ns / 1000,
+	    *gpu_fence_cpu, seq, target[0]);
+	sweet_gpu_unmap(va, 8192);
+	sweet_gpu_va_free(va, 8192);
+	IOFreeAligned(page, 8192);
+}
+
