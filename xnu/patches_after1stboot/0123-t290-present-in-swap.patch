+/*
+ * Native: a BGRA picture of panel size -> panel bytes R,B,G, 4 pixels per
+ * 3 words. Screen x >= shift lives at buffer x - shift on the same row,
+ * screen x < shift wraps to the end of the row above: two runs per row.
+ */
+static inline uint32_t
+t290_rbg(uint32_t p)
+{
+	return ((p >> 16) & 0xff) | (p & 0xff) << 8 | ((p >> 8) & 0xff) << 16;
+}
+
+void
+AppleCLCD::t290Convert(uintptr_t pix, uint32_t rowBytes)
+{
+	uint32_t n = fPanelW * 3, sh = fPanelShift * 3;
+	for (uint32_t y = 0; y < fPanelH; y++) {
+		const uint32_t *src = (const uint32_t *)(pix + (uint64_t)y * rowBytes);
+		uint32_t *t = (uint32_t *)fRowBuf;
+		for (uint32_t x = 0; x + 4 <= fPanelW; x += 4, src += 4, t += 3) {
+			uint32_t c0 = t290_rbg(src[0]), c1 = t290_rbg(src[1]);
+			uint32_t c2 = t290_rbg(src[2]), c3 = t290_rbg(src[3]);
+			t[0] = c0 | c1 << 24;
+			t[1] = c1 >> 8 | c2 << 16;
+			t[2] = c2 >> 16 | c3 << 8;
+		}
+		uint8_t *row = (uint8_t *)(fPanel + (uint64_t)y * fPanelRow);
+		bcopy(fRowBuf + sh, row, n - sh);
+		if (y > 0 && sh != 0) {
+			bcopy(fRowBuf, row - fPanelRow + (n - sh), sh);
+		}
+	}
+}
+
+/* SwapEnd with one full-screen BGRA layer (native mode): straight to the panel. */
+bool
+AppleCLCD::t290Direct(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+	int layer = -1;
+	for (int l = 0; l < SWEET_FB_LAYERS; l++) {
+		if ((mask & (1u << l)) && get32(rec, 0x54 + 4 * l) != 0) {
+			if (layer >= 0) {
+				return false;           /* several layers: the general path */
+			}
+			layer = l;
+		}
+	}
+	if (layer < 0) {
+		return false;
+	}
+	const uint8_t *a = rec + 0x64 + 16 * layer;
+	const uint8_t *b = rec + 0xc4 + 16 * layer;
+	if (get32(a, 0) || get32(a, 4) || get32(b, 0) || get32(b, 4) ||
+	    get32(b, 8) != fPanelW || get32(b, 12) != fPanelH) {
+		return false;
+	}
+	SweetSurface *sf = sweet_surface_copy(get32(rec, 0x54 + 4 * layer));
+	if (sf == NULL) {
+		return false;
+	}
+	bool ok = sf != fSurface && sf->memory != NULL && sf->elementWidth == 1 &&
+	    sf->elementHeight == 1 && (sf->bytesPerElement == 0 || sf->bytesPerElement == 4) &&
+	    sf->width >= fPanelW && sf->height >= fPanelH &&
+	    (uint64_t)sf->offset + (uint64_t)(fPanelH - 1) * sf->bytesPerRow + fPanelW * 4 <=
+	    sf->memory->getLength();
+	if (ok) {
+		uint64_t t0 = mach_absolute_time();
+		t290Convert(sf->kernelAddress() + sf->offset, sf->bytesPerRow);
+		uint64_t t1 = mach_absolute_time();
+		fStatConv += t1 - t0;
+		if (fStatFrames++ == 0) {
+			fStatT0 = t0;
+		} else if (fStatFrames == 600) {
+			uint64_t all, conv;
+			absolutetime_to_nanoseconds(t1 - fStatT0, &all);
+			absolutetime_to_nanoseconds(fStatConv, &conv);
+			IOLog("SWEET FB: %llu.%llu fps (600 frames), convert %llu us per frame\n",
+			    599ULL * 1000000000ULL / all, (5990ULL * 1000000000ULL / all) % 10,
+			    conv / 600 / 1000);
+			fStatFrames = 0;
+			fStatConv = 0;
+		}
+	}
+	sf->release();
+	return ok;
+}
