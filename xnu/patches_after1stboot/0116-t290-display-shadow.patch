+#if defined(SWEET_T290)
+bool
+AppleCLCD::t290Setup(void)
+{
+	DTEntry entry;
+	uint32_t const *val;
+	unsigned int size;
+
+	fPanelW = fWidth;
+	fPanelH = fHeight;
+	fPanelRow = fRowBytes;
+	fPanelShift = 0;
+	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) == kSuccess &&
+	    SecureDTGetProperty(entry, "shift", (void const **)&val, &size) == kSuccess &&
+	    *val < fPanelW) {
+		fPanelShift = *val;
+	}
+	if (fPanelW < T290_SHADOW_W / 2 || fPanelH < T290_SHADOW_H / 2) {
+		return false;
+	}
+	fPanel = ml_io_map_wcomb((vm_offset_t)fPhys, (vm_size_t)fPanelRow * fPanelH);
+	fShadow = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous,
+	    (vm_size_t)T290_SHADOW_W * T290_SHADOW_H * 4, 0x00000000fffff000ULL);
+	if (fPanel == 0 || fShadow == NULL) {
+		return false;
+	}
+	bzero(fShadow->getBytesNoCopy(), fShadow->getLength());
+	fPhys = fShadow->getPhysicalAddress();
+	/* the IOSurface maps the shadow again: no dirty lines of this alias may linger */
+	flush_dcache64((addr64_t)fPhys, (unsigned)fShadow->getLength(), TRUE);
+	fWidth = T290_SHADOW_W;
+	fHeight = T290_SHADOW_H;
+	fRowBytes = T290_SHADOW_W * 4;
+	fT290 = true;
+	IOLog("SWEET FB: T290 panel %ux%u RGB888 shift %u, GUI on a %ux%u shadow at 0x%llx\n",
+	    fPanelW, fPanelH, fPanelShift, fWidth, fHeight, fPhys);
+	return true;
+}
+
+/* Shadow (BGRA) -> panel: 1/2 nearest, centred, bytes R,B,G, scan-out shift. */
+void
+AppleCLCD::t290Panel(void)
+{
+	uint32_t outW = fWidth / 2, outH = fHeight / 2;
+	uint32_t ox = (fPanelW - outW) / 2, oy = (fPanelH - outH) / 2;
+
+	if (!fPanelCleared) {
+		fPanelCleared = true;
+		for (uint64_t i = 0; i < (uint64_t)fPanelRow * fPanelH; i += 4) {
+			*(volatile uint32_t *)(fPanel + i) = 0;
+		}
+	}
+	for (uint32_t py = 0; py < outH; py++) {
+		const uint32_t *src = (const uint32_t *)(fPixels + (uint64_t)(2 * py) * fRowBytes);
+		uint32_t sy = oy + py;
+		for (uint32_t px = 0; px < outW; px++) {
+			uint32_t v = src[2 * px];
+			int32_t bx = (int32_t)(ox + px) - (int32_t)fPanelShift;
+			uint32_t by = sy;
+			if (bx < 0) {
+				if (by == 0) {
+					continue;
+				}
+				bx += (int32_t)fPanelW;
+				by--;
+			}
+			volatile uint8_t *d = (volatile uint8_t *)(fPanel + (uint64_t)by * fPanelRow + (uint64_t)bx * 3);
+			d[0] = (uint8_t)(v >> 16);      /* R */
+			d[1] = (uint8_t)v;              /* B */
+			d[2] = (uint8_t)(v >> 8);       /* G */
+		}
+	}
 }
+#endif
 
