+#define T290_HEAD_PHYS  0x92100000UL
+static volatile uint8_t *t290_head;
+static uint32_t t290_head_pos;
+
+static void
+t290_head_put(const char *c, int size)
+{
+	for (int i = 0; i < size && t290_head_pos < T290_PRZ_DATA; i++) {
+		t290_head[12 + t290_head_pos++] = (uint8_t)c[i];
+	}
+	((volatile uint32_t *)t290_head)[1] = t290_head_pos;
+	((volatile uint32_t *)t290_head)[2] = t290_head_pos;
+}
