diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index cb67b4d..70891e8 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -367,6 +367,43 @@ static struct mac_policy_conf sweet_amfi_mac_conf = {
 
 static mac_policy_handle_t sweet_amfi_mac_handle;
 
+/*
+ * Policy "AMFI": dyld asks __mac_syscall("AMFI", 90, {u64 in flags, u64
+ * *out flags}) which DYLD_* variables it may honour. Without the policy the
+ * call fails and dyld restricts every process. Allow @paths, path and
+ * print variables, fallback paths, interposing, embedded variables and a
+ * failed insertion (the process keeps running); not a custom shared cache.
+ */
+#define SWEET_AMFI_CHECK_DYLD_POLICY    90
+#define SWEET_AMFI_DYLD_ALLOW           0xfbULL
+
+static int
+sweet_amfi_syscall(__unused struct proc *p, int call, user_addr_t arg)
+{
+	uint64_t args[2];
+	if (call != SWEET_AMFI_CHECK_DYLD_POLICY) {
+		return ENOPOLICY;
+	}
+	int error = copyin(arg, args, sizeof(args));
+	if (error == 0) {
+		uint64_t out = SWEET_AMFI_DYLD_ALLOW;
+		error = copyout(&out, (user_addr_t)args[1], sizeof(out));
+	}
+	return error;
+}
+
+static const struct mac_policy_ops sweet_dyld_mac_ops = {
+	.mpo_policy_syscall = sweet_amfi_syscall,
+};
+
+static struct mac_policy_conf sweet_dyld_mac_conf = {
+	.mpc_name = "AMFI",
+	.mpc_fullname = "SWEET dyld policy",
+	.mpc_ops = &sweet_dyld_mac_ops,
+};
+
+static mac_policy_handle_t sweet_dyld_mac_handle;
+
 /* Called from bsd_init once MAC policies can register, before any exec. */
 void sweet_amfi_policy_register(void);
 
@@ -379,5 +416,8 @@ sweet_amfi_policy_register(void)
 	error = mac_policy_register(&sweet_sandbox_mac_conf, &sweet_sandbox_mac_handle, NULL);
 	printf("SWEET Sandbox: permissive policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+	error = mac_policy_register(&sweet_dyld_mac_conf, &sweet_dyld_mac_handle, NULL);
+	printf("SWEET AMFI: dyld policy %s (%d)\n",
+	    error ? "NOT registered" : "registered", error);
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
