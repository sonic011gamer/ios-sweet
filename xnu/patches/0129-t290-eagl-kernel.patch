+IOReturn
+SweetGPUUserClient::alloc(uint64_t size, uint64_t *out)
+{
+	size = (size + 0xfff) & ~0xfffULL;
+	if (size == 0 || size > 256ULL << 20) {
+		return kIOReturnBadArgument;
+	}
+	IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache, size, 4096);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	bzero(md->getBytesNoCopy(), size);
+	uint64_t va = 0;
+	IOReturn ret = map_into_window(md, size, &va);
+	if (ret == kIOReturnSuccess) {
+		ret = add_buffer(md, va, size, 0, false, out);
+	}
+	if (ret != kIOReturnSuccess) {
+		md->release();
+	}
+	return ret;
+}
+
+/*
+ * Map an IOSurface's pixels into the GPU window (render target or texture
+ * without a copy). Buffer surfaces are cached kernel memory: remember their
+ * kernel address for the D-cache maintenance around GPU work.
+ */
+IOReturn
+SweetGPUUserClient::import_surface(uint32_t id, uint64_t *out)
+{
+	SweetSurface *s = sweet_surface_copy(id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	IOMemoryDescriptor *md = s->memory;
+	uint64_t size = ((uint64_t)s->allocSize + 0xfff) & ~0xfffULL;
+	uintptr_t kva = 0;
+	if (md != NULL) {
+		md->retain();
+		if (OSDynamicCast(IOBufferMemoryDescriptor, md) != NULL) {
+			kva = s->kernelAddress();
+		}
+	}
+	s->release();
+	if (md == NULL || size == 0) {
+		OSSafeReleaseNULL(md);
+		return kIOReturnBadArgument;
+	}
+	if (size > md->getLength()) {
+		size = md->getLength() & ~0xfffULL;
+	}
+	IOReturn ret = md->prepare();
+	if (ret != kIOReturnSuccess) {
+		md->release();
+		return ret;
+	}
+	uint64_t va = 0;
+	ret = map_into_window(md, size, &va);
+	if (ret == kIOReturnSuccess) {
+		ret = add_buffer(md, va, size, kva, true, out);
+	}
+	if (ret != kIOReturnSuccess) {
+		md->complete();
+		md->release();
+	}
+	static int logged;
+	if (logged++ < 16) {
+		printf("SWEET GPU: import surface %u -> %#llx + %#llx%s (0x%x)\n", id, va, size,
+		    kva ? " cached" : "", ret);
+	}
+	return ret;
+}
+
+void
+SweetGPUUserClient::flush_surfaces(void)
+{
+	IOLockLock(fLock);
+	for (uint32_t i = 0; i < SWEET_GPU_MAX_BUFFERS; i++) {
+		if (fBuf[i].md != NULL && fBuf[i].kva != 0) {
+			FlushPoC_DcacheRegion(fBuf[i].kva, (size_t)fBuf[i].size);
+		}
+	}
+	IOLockUnlock(fLock);
+}
