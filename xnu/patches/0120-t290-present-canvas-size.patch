+	OSNumber *cw = OSDynamicCast(OSNumber, provider->getProperty("canvas-width"));
+	OSNumber *chp = OSDynamicCast(OSNumber, provider->getProperty("canvas-height"));
+	uint32_t canvasW = cw != NULL ? cw->unsigned32BitValue() : 0;
+	uint32_t canvasH = chp != NULL ? chp->unsigned32BitValue() : 0;
+	if (canvasW != 0 && canvasH != 0) {
+		IOLog("SWEET FB: provider canvas %ux%u\n", canvasW, canvasH);
+	}
