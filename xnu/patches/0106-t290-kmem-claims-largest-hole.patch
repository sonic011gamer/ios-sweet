 	 * Add claims for ptr and data kmem_ranges
 	 */
 	kmem_add_extra_claims();
+#if defined(SWEET_T290)
+	start = sweet_kernel_map_largest_hole();
+	printf("SWEET kmem: claims from 0x%llx\n", (uint64_t)start);
+#endif
 
