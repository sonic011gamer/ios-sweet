diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..4c6e1e1 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,20 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if __ARM_FEATURE_ATOMICS
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#else
+	/* No LSE (Cortex-A53): the same trylock with exclusives. */
+Ltrylock_enqueue_llsc:
+	ldaxr	w10, [x3]
+	cbnz	w10, Ltrylock_enqueue_llsc_busy
+	stxr	w9, w11, [x3]
+	cbnz	w9, Ltrylock_enqueue_llsc
+	b	Ltrylock_enqueue_llsc_done
+Ltrylock_enqueue_llsc_busy:
+	clrex
+Ltrylock_enqueue_llsc_done:
+#endif
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +336,20 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if __ARM_FEATURE_ATOMICS
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#else
+	/* No LSE (Cortex-A53): the same trylock with exclusives. */
+Ltrylock_dequeue_llsc:
+	ldaxr	w10, [x2]
+	cbnz	w10, Ltrylock_dequeue_llsc_busy
+	stxr	w9, w11, [x2]
+	cbnz	w9, Ltrylock_dequeue_llsc
+	b	Ltrylock_dequeue_llsc_done
+Ltrylock_dequeue_llsc_busy:
+	clrex
+Ltrylock_dequeue_llsc_done:
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
