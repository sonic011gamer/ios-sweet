--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -706,9 +706,13 @@ register_serial_functions(struct pe_serial_functions *fns)
  * the boot framebuffer described by the ADT node "sweet-fbcon":
  *   reg    = <phys size>       absolute physical address, not arm-io relative
  *   width, height              pixels
- *   stride                     bytes per line, 32bpp
+ *   stride                     bytes per line
+ *   bpp (optional)             bytes per pixel, 4 (default) or 3
+ *   shift (optional)           pixels the panel scans the buffer out to the
+ *                              right, with wrap-around (SM-T290 splash: 229)
  * Lines wrap back to the top instead of scrolling; the line after the cursor
- * is kept blank so the newest output is easy to find.
+ * is kept blank so the newest output is easy to find. Text is white on
+ * black, so the colour order of a 24 bpp splash does not matter.
  */
 
 extern unsigned char iso_font[256 * 16];
@@ -720,14 +724,36 @@ extern unsigned char iso_font[256 * 16];
 static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+static uint32_t fbcon_bpp = 4, fbcon_shift;
+
+/* One pixel at screen (x, y): honours bpp and the scan-out shift. */
+static void
+fbcon_px(uint32_t x, uint32_t y, uint32_t argb)
+{
+	if (fbcon_bpp == 4 && !fbcon_shift) {
+		fbcon_base[y * (fbcon_stride / 4) + x] = argb;
+		return;
+	}
+	if (x < fbcon_shift) {
+		if (y == 0) {
+			return;
+		}
+		x += fbcon_width;
+		y--;
+	}
+	x -= fbcon_shift;
+	volatile uint8_t *b = (volatile uint8_t *)fbcon_base + y * fbcon_stride + x * fbcon_bpp;
+	for (uint32_t i = 0; i < fbcon_bpp; i++) {
+		b[i] = (uint8_t)(argb >> (8 * i));
+	}
+}
 
 static void
 fbcon_clear_row(uint32_t row)
 {
 	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
-		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
 		for (uint32_t x = 0; x < fbcon_width; x++) {
-			line[x] = FBCON_BG;
+			fbcon_px(x, y, FBCON_BG);
 		}
 	}
 }
@@ -776,11 +802,10 @@ fbcon_transmit_data(uint8_t c)
 	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
 	for (uint32_t gy = 0; gy < 16; gy++) {
 		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
-			volatile uint32_t *line = fbcon_base + (y0 + gy * FBCON_SCALE + sy) * (fbcon_stride / 4) + x0;
 			for (uint32_t gx = 0; gx < 8; gx++) {
 				uint32_t px = (glyph[gy] & (1u << gx)) ? FBCON_FG : FBCON_BG;
 				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
-					line[gx * FBCON_SCALE + sx] = px;
+					fbcon_px(x0 + gx * FBCON_SCALE + sx, y0 + gy * FBCON_SCALE + sy, px);
 				}
 			}
 		}
@@ -818,6 +843,10 @@ fbcon_probe(void)
 	uint32_t const *val;
 	unsigned int size;
 
+#if defined(SWEET_T290)
+	extern void sweet_t290_pstore_init(void);       /* osfmk/console/serial_console.c */
+	sweet_t290_pstore_init();
+#endif
 	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess ||
 	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
 		return;
@@ -831,7 +860,15 @@ fbcon_probe(void)
 	if (SecureDTGetProperty(entry, "stride", (void const **)&val, &size) == kSuccess) {
 		fbcon_stride = *val;
 	}
-	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
+	if (SecureDTGetProperty(entry, "bpp", (void const **)&val, &size) == kSuccess &&
+	    (*val == 3 || *val == 4)) {
+		fbcon_bpp = *val;
+	}
+	if (SecureDTGetProperty(entry, "shift", (void const **)&val, &size) == kSuccess) {
+		fbcon_shift = *val;
+	}
+	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * fbcon_bpp ||
+	    fbcon_shift >= fbcon_width) {
 		return;
 	}
 	sweet_early_mark(17, "fbcon config read; mapping");
