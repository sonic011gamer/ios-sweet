diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index c86b9e7..ede28cb 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -276,6 +276,65 @@ extern void sweet_log_append(const char *c, int size);  /* bsd/dev/sweet_ufs.c *
 int sweet_console_muted;
 #endif
 
+#if defined(SWEET_T290)
+/*
+ * SM-T290: no UART on the board's connector, so the console is mirrored
+ * into the ramoops console zone the tablet's Linux reserves
+ * (reserved-memory ramoops@92100000: one 256K dump record, then the
+ * console). DDR survives the reset, and the next Android/TWRP boot shows
+ * everything in /sys/fs/pstore/console-ramoops-0 (persistent_ram_buffer:
+ * sig "DBGC", start, size, data). Started from fbcon_probe() once
+ * ml_io_map works; the bytes logged before are copied from sweet_log's
+ * ring first.
+ */
+#define T290_PRZ_PHYS   0xd9d00000UL
+#define T290_PRZ_SIZE   0x40000U
+#define T290_PRZ_DATA   (T290_PRZ_SIZE - 12)
+#define T290_PRZ_SIG    0x43474244U
+
+static volatile uint8_t *t290_prz;
+static uint32_t t290_prz_pos, t290_prz_full;
+
+static void
+t290_prz_put(const char *c, int size)
+{
+	volatile uint32_t *hdr = (volatile uint32_t *)t290_prz;
+	for (int i = 0; i < size; i++) {
+		t290_prz[12 + t290_prz_pos] = (uint8_t)c[i];
+		if (++t290_prz_pos == T290_PRZ_DATA) {
+			t290_prz_pos = 0;
+			t290_prz_full = 1;
+		}
+	}
+	hdr[1] = t290_prz_pos;                                 /* start */
+	hdr[2] = t290_prz_full ? T290_PRZ_DATA : t290_prz_pos; /* size */
+}
+
+void sweet_t290_pstore_init(void);
+
+void
+sweet_t290_pstore_init(void)
+{
+	extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+	extern uint64_t sweet_log_position(void);
+	volatile uint8_t *m = (volatile uint8_t *)ml_io_map(T290_PRZ_PHYS, T290_PRZ_SIZE);
+	if (m == NULL || t290_prz != NULL) {
+		return;
+	}
+	((volatile uint32_t *)m)[0] = T290_PRZ_SIG;
+	((volatile uint32_t *)m)[1] = 0;
+	((volatile uint32_t *)m)[2] = 0;
+	uint64_t total = sweet_log_position();
+	uint64_t pos = total > T290_PRZ_DATA ? total - T290_PRZ_DATA : 0;
+	char chunk[256];
+	uint32_t n;
+	t290_prz = m;
+	while (pos < total && (n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+		t290_prz_put(chunk, (int)n);
+	}
+}
+#endif
+
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
@@ -283,6 +342,11 @@ _cnputs(char *c, int size, bool poll)
 
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	sweet_log_append(c, size);
+#if defined(SWEET_T290)
+	if (t290_prz != NULL && size > 0) {
+		t290_prz_put(c, size);
+	}
+#endif
 	if (sweet_console_muted && !panic_active()) {
 		return;
 	}
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
