+#else
+#define SP_CORE_PA  0x0c440000u
+#define SP_OBS_PA   0x0e600000u
+#define SP_CFG_PA   0x0c40a000u
+#define SP_CORE_SZ  0x2000
+#define SP_OBS_SZ   0x10000	/* EE 0, 512 * 0x80 */
+#define SP_MAP      0x900u
+#define SP_STRIDE   0x80u
+#define SP_MAX_APID 512u
+#endif
