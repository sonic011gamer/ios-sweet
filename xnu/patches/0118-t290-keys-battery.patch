-		    arb_version, sp_count);
+	bool ok = arb_version >= 0x50000000u && arb_version < 0x70000000u &&
+	    sp_count && sp_count <= SP_MAX_APID;
+#endif
+	if (!ok) {
+		printf("SWEET SPMI: unsupported arb=%#x APIDs=%u\n", arb_version, sp_count);
 		return -1;
 	}
-	sp_ready = true;
-	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u, observer reads only\n",
-	    arb_version, sp_count);
+	printf("SWEET SPMI: arb=%#x APIDs=%u, observer reads only\n", arb_version, sp_count);
