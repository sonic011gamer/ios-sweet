-	    peripheral != 0x13 && peripheral != 0x48)) {
+	if (!sp_ready || !out || addr > 0xffffu || !sp_allowed(sid, peripheral)) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
@@ -99,7 +152,7 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 		IOLockUnlock(sp_lock);
 		return -1;
 	}
-	unsigned off = 0x80u * apid;
+	unsigned off = SP_STRIDE * apid;
 	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
 	__asm__ volatile("dmb oshst" ::: "memory");
 	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
@@ -118,7 +171,7 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 		delay(1);
 	}
 	sp_poisoned[apid] = true;
-	printf("SWEET BATTERY: SPMI timeout sid=%u addr=%#x APID=%u disabled\n",
+	printf("SWEET SPMI: timeout sid=%u addr=%#x APID=%u disabled\n",
 	    sid, addr, apid);
