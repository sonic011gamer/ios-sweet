 }
 
+int
+sweet_spmi_init(void)
+{
+	if (OSCompareAndSwap(0, 1, &sp_state)) {
+		sp_ready = sp_map() == 0;
+		__asm__ volatile("dmb ish" ::: "memory");
+		sp_state = 2;
+	}
+	while (sp_state != 2) {
+		delay(1000);
+	}
+	return sp_ready ? 0 : -1;
+}
+
+static bool
+sp_allowed(unsigned sid, unsigned peripheral)
+{
+	if (sid == SWEET_PMIC_CHG_SID &&
+	    (peripheral == 0x10 || peripheral == 0x11 || peripheral == 0x12 ||
+	    peripheral == 0x13 || peripheral == 0x48)) {
+		return true;
+	}
+#if defined(SWEET_T290)
+	if (sid == 0 && peripheral == 0x08) {	/* PM8953 PON: power + volume-down */
+		return true;
+	}
+#endif
+	return false;
+}
