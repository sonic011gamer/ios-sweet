diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index a148608..f1778fa 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -17,6 +17,98 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_key(int key, int down);
 void sweet_keys_init(void);
 
+#if defined(SWEET_T290)
+/*
+ * SM-T290: power = PM8953 PON KPDPWR and volume-down = PON RESIN
+ * (PON_INT_RT_STS 0x0810 bits 0 and 1, SID 0, read through sweet_spmi.c),
+ * volume-up = TLMM GPIO 91, active low (gpio-keys in the live FDT).
+ * Polled every 20 ms on one thread. The only write is GPIO 91's own TLMM
+ * config, and only if it is not already an input.
+ */
+#include "sweet_spmi.h"
+
+#define T290_GPIO91_PA 0x0105b000u	/* TLMM 0x1000000 + 91 * 0x1000 */
+
+static vm_offset_t keys_gpio;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	int state[3] = {0, 0, 0};
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	bool spmi = sweet_spmi_init() == 0;
+	uint8_t pon = 0;
+	bool pok = spmi && !sweet_spmi_read(0, 0x0810, &pon);
+	printf("SWEET KEYS: T290 spmi=%d pon=%#x/%d gpio91=%#x\n", spmi, pon, pok,
+	    *(volatile uint32_t *)(keys_gpio + 4));
+	for (;;) {
+		pon = 0;
+		pok = spmi && !sweet_spmi_read(0, 0x0810, &pon);
+		uint32_t gpio = *(volatile uint32_t *)(keys_gpio + 4);
+		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		if (!pok && spmi && (errors++ % 250u) == 0) {
+			printf("SWEET KEYS: PON read error\n");
+		}
+		for (int k = 0; k < 3; ++k) {
+			if ((k == 1 || pok) && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio91=%#x\n",
+				    k, state[k], pon, gpio);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		keys_wait();
+	}
+}
+
+void
+sweet_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	keys_gpio = ml_io_map(T290_GPIO91_PA, 0x1000);
+	if (!keys_gpio) {
+		printf("SWEET KEYS: MMIO mapping failed\n");
+		return;
+	}
+	uint32_t cfg = *(volatile uint32_t *)keys_gpio;
+	/* bits 1:0 pull, 5:2 function, 9 output enable: want GPIO input, pull-up */
+	if ((cfg & (1u << 9)) || (cfg & 0x3cu)) {
+		*(volatile uint32_t *)keys_gpio = 0x3u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	printf("SWEET KEYS: T290 gpio91 cfg=%#x -> %#x\n", cfg, *(volatile uint32_t *)keys_gpio);
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#else /* !SWEET_T290 */
+
 #define KEYS_CORE_PA     0x0c440000u
 #define KEYS_OBS_PA      0x0e600000u
 #define KEYS_CNFG_PA     0x0c40a000u
@@ -179,4 +271,5 @@ sweet_keys_init(void)
 		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
 	}
 }
+#endif /* SWEET_T290 */
 #endif /* ARM64_BOARD_CONFIG_SWEET */
