+/*
+ * Seed the charge counter with the SOC Android's fuel gauge last saved; if
+ * there is none, with the voltage estimate (logged as such).
+ */
+void
+SweetBattery::seedFromSdam(unsigned mv)
+{
+	uint8_t dump[32], valid = 0, soc = 0xff;
+	bool ok = true;
+	for (unsigned i = 0; i < sizeof(dump); i++) {
+		ok = ok && !sweet_spmi_read(SWEET_PMIC_CHG_SID, SWEET_QG_SDAM + 0x40 + i, &dump[i]);
+	}
+	if (ok) {
+		valid = dump[SWEET_QG_SDAM_VALID - 0x40];
+		soc = dump[SWEET_QG_SDAM_SOC - 0x40];
+		IOLog("SWEET BATTERY: QG SDAM 0xb140: %02x %02x %02x %02x %02x %02x %02x %02x "
+		    "%02x %02x %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    dump[0], dump[1], dump[2], dump[3], dump[4], dump[5], dump[6], dump[7],
+		    dump[8], dump[9], dump[10], dump[11], dump[12], dump[13], dump[14], dump[15],
+		    dump[16], dump[17], dump[18], dump[19], dump[20], dump[21], dump[22], dump[23]);
+	}
+	unsigned percent;
+	if (ok && valid && soc <= 100) {
+		percent = soc;
+		IOLog("SWEET BATTERY: SOC %u%% from Android's fuel gauge (SDAM valid %#x)\n", soc, valid);
+	} else {
+		percent = estimatePercent(mv);
+		IOLog("SWEET BATTERY: no saved SOC (read %d valid %#x soc %u), voltage estimate %u%%\n",
+		    ok, valid, soc, percent);
+	}
+	fChargeUah = (int64_t)SWEET_BATTERY_MAH * 1000 * percent / 100;
+	fCounting = true;
+}
+
 void
 SweetBattery::poll(void)
 {
@@ -246,8 +294,40 @@ SweetBattery::poll(void)
 		/* Linux: negative=charging; IOPMPowerSource: positive=charging, mA. */
 		ma = (int)(-((int64_t)signedRaw * (subtype == 3 ? 152588 : 305176)) / 1000000);
 	}
+#if defined(SWEET_T290)
+	/* Count charge: trapezoid of the last two current samples over the poll gap. */
+	uint64_t now = mach_absolute_time();
+	if (!fCounting) {
+		seedFromSdam(mv);
+	} else if (currentValid && fLastPoll) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(now - fLastPoll, &ns);
+		if (ns < 600ull * NSEC_PER_SEC) {       /* skip gaps across sleep */
+			fChargeUah += (int64_t)(ma + fLastMa) * (int64_t)(ns / 1000000ull) / 7200;
+		}
+	}
+	fLastPoll = now;
+	fLastMa = currentValid ? ma : 0;
+	const int64_t fullUah = (int64_t)SWEET_BATTERY_MAH * 1000;
+	if (full) {
+		fChargeUah = fullUah;
+	}
+	if (fChargeUah > fullUah) {
+		fChargeUah = fullUah;
+	}
+	if (fChargeUah < 0) {
+		fChargeUah = 0;
+	}
+	unsigned percent = (unsigned)((fChargeUah * 100 + fullUah / 2) / fullUah);
+	/* the voltage floor keeps a drifting counter from showing a live battery as empty */
+	if (percent == 0 && mv > 3500) {
+		percent = 1;
+	}
+	publish(percent, mv, ma, external, capable, charging, full, true, currentValid);
+#else
 	publish(full ? 100 : estimatePercent(mv), mv, ma, external, capable,
 	    charging, full, true, currentValid);
+#endif
 }
 
