+/*
+ * Absolute card sectors for bsd/dev/sweet_t290_xfer.c (the raw area past
+ * the root volume): at most 1 MiB, through the bounce buffer, locked.
+ */
+int sweet_sdhc_raw(uint64_t lba, void *buf, uint32_t nsec, bool write);
+int
+sweet_sdhc_raw(uint64_t lba, void *buf, uint32_t nsec, bool write)
+{
+	char *bounce = (char *)(sd.dma + DMA_BOUNCE);
+	if (!sd.ready || nsec == 0 || nsec > BOUNCE_SIZE / SECTOR || (write && !sd.writable)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_sdhc_lock);
+	if (write) {
+		memcpy(bounce, buf, (size_t)nsec * SECTOR);
+	}
+	int error = sd_rw(lba, nsec, write);
+	if (!error && !write) {
+		memcpy(buf, bounce, (size_t)nsec * SECTOR);
+	}
+	lck_mtx_unlock(&sweet_sdhc_lock);
+	return error;
+}
