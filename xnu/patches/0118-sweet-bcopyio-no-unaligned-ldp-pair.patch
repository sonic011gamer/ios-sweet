diff --git a/osfmk/arm64/machine_routines_asm.s b/osfmk/arm64/machine_routines_asm.s
index 2449334..4aa968a 100644
--- a/osfmk/arm64/machine_routines_asm.s
+++ b/osfmk/arm64/machine_routines_asm.s
@@ -459,9 +459,16 @@ LEXT(_bcopyin)
 	b.lt	2f
 	sub		x2, x2, #16
 1:
-	/* 16 bytes at a time */
-	ldp		x3, x4, [x0], #16
-	stp		x3, x4, [x1], #16
+	/* 16 bytes at a time, split into two single 8-byte accesses. On
+	 * msm8994 (raw4: copyinmap -> _bcopyin) a 64-bit LDP/STP pair at an
+	 * 8-byte-aligned address (straddling a 16-byte boundary) took an
+	 * alignment fault (esr 0x96000002), although per the ARMv8
+	 * architecture pair alignment is per element and identical pairs ran
+	 * fault-free on the A53 t290 tablet build. A single 8-byte access at
+	 * 8-byte alignment is legal on any memory type on any ARMv8 core.
+	 */
+	ldr		x3, [x0], #8
+	ldr		x4, [x0], #8
+	str		x3, [x1], #8
+	str		x4, [x1], #8
 	subs	x2, x2, #16
 	b.ge	1b
 	/* Fixup the len and test for completion */
@@ -630,9 +637,14 @@ LEXT(_bcopyout)
 	b.lt	2f
 	sub		x2, x2, #16
 1:
-	/* 16 bytes at a time */
-	ldp		x3, x4, [x0], #16
-	stp		x3, x4, [x1], #16
+	/* 16 bytes at a time, split into two single 8-byte accesses: the
+	 * destination is a user address here, and the same LDP/STP-pair
+	 * hazard as in _bcopyin applies (msm8994 alignment fault on an
+	 * 8-byte-aligned pair; single 8B accesses are always legal). */
+	ldr		x3, [x0], #8
+	ldr		x4, [x0], #8
+	str		x3, [x1], #8
+	str		x4, [x1], #8
 	subs	x2, x2, #16
 	b.ge	1b
 	/* Fixup the len and test for completion */
