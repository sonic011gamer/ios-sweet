diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..0bc8d74 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -222,6 +222,142 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif HAS_GIC_V2
+/*
+ * SWEET_T290: GICv2 with a memory-mapped CPU interface (SDM429 QGIC2, QEMU virt
+ * gic-version=2). DT /arm-io/gic reg = <GICD base, size, GICC base, size>.
+ */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+/* SGIs address CPU interfaces, not MPIDRs: each CPU records its own bit. */
+static uint8_t gic_cpu_mask[MAX_CPUS];
+
+static uint32_t
+_gic_read32(vm_offset_t addr)
+{
+	return *((volatile uint32_t *) addr);
+}
+
+static void
+_gic_write32(vm_offset_t addr, uint32_t value)
+{
+	*((volatile uint32_t *) addr) = value;
+}
+
+#define gicd_read32(offset) (_gic_read32(gicd_base + (offset)))
+#define gicd_write32(offset, data) (_gic_write32(gicd_base + (offset), (data)))
+#define gicc_read32(offset) (_gic_read32(gicc_base + (offset)))
+#define gicc_write32(offset, data) (_gic_write32(gicc_base + (offset), (data)))
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+
+	// The boot processor maps the GIC; secondaries must not use SecureDT*.
+	if (!gicd_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		void const *prop;
+		unsigned int prop_size;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *reg = (uint64_t const *) prop;
+
+		gicd_base = ml_io_map(soc_base_phys + reg[0], reg[1]);
+		if (!gicd_base) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+		gicc_base = ml_io_map(soc_base_phys + reg[2], reg[3]);
+		if (!gicc_base) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+		kprintf("SWEET GIC: GICv2 GICD 0x%llx GICC 0x%llx, virtual timer INTID %u
+",
+		    soc_base_phys + reg[0], soc_base_phys + reg[2], sweet_vtimer_intid);
+	}
+
+	/*
+	 * GICD_ITARGETSR0..7 are banked and read back the reading CPU's own
+	 * interface bit; a uniprocessor GIC may return 0 (Linux gic_get_cpumask).
+	 */
+	unsigned int cpu = ml_get_cpu_number_local();
+	uint8_t mask = (uint8_t)gicd_read32(GICD_ITARGETSR0);
+	if (mask == 0) {
+		mask = (uint8_t)(1U << cpu);
+	}
+	if (cpu < MAX_CPUS) {
+		gic_cpu_mask[cpu] = mask;
+	}
+
+	// Banked SGI/PPI state of this CPU: priority, then enable timer + IPI.
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+
+	gicc_write32(GICC_PMR, 0xFF);
+	gicc_write32(GICC_BPR, 0);
+	uint32_t gicc_ctlr = gicc_read32(GICC_CTLR);
+	gicc_ctlr &= ~GICC_CTLR_EOIMODENS;
+	gicc_ctlr |= GICC_CTLR_ENABLE;
+	gicc_write32(GICC_CTLR, gicc_ctlr);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+
+	kprintf("SWEET GIC: cpu %u interface mask 0x%x
+", cpu, mask);
+}
+
+uint32_t
+sweet_gic_ack(void)
+{
+	return gicc_read32(GICC_IAR);
+}
+
+void
+sweet_gic_eoi(uint32_t iar)
+{
+	gicc_write32(GICC_EOIR, iar);
+}
+
+void
+sweet_gic_send_sgi(unsigned int cpu, unsigned int sgi)
+{
+	if (cpu >= MAX_CPUS || gic_cpu_mask[cpu] == 0) {
+		panic("%s: no GIC interface known for cpu %u", __func__, cpu);
+	}
+	__builtin_arm_dsb(DSB_ISHST);
+	gicd_write32(GICD_SGIR, ((uint32_t)gic_cpu_mask[cpu] << GICD_SGIR_TARGET_SHIFT) | (sgi & 0xF));
+}
 #else
 void
 pe_init_fiq()
