diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..d524a21 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -17,13 +17,24 @@
 
 #define SWEET                     1
 
+/*
+ * SWEET_T290 (make SWEET_BOARD=t290, see MakeInc.def): the same SWEET kernel
+ * for the Samsung Galaxy Tab A 8.0 2019 (SM-T290, Qualcomm SDM429): four
+ * Cortex-A53 (ARMv8.0: no 16K translation granule, no PAN, no LSE) and a
+ * GICv2 (QGIC2). 4K pages like Apple's BCM2837 (Raspberry Pi 3) config.
+ */
+
 /*
  * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
  * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
  * CPU_ON; the scheduler does not know the A76s are faster (no AMP/P-E
  * clusters yet).
  */
+#if SWEET_T290
+#define SWEET_SMP_MAX_CPUS         4
+#else
 #define SWEET_SMP_MAX_CPUS         8
+#endif
 
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
@@ -33,10 +44,15 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#if SWEET_T290
+#define __ARM64_PMAP_SUBPAGE_L1__ 1
+#define HAS_GIC_V2                1
+#else
 #define __ARM_PAN_AVAILABLE__     1
 #define __ARM_16K_PG__            1
 
 #define HAS_GIC_V3                1
+#endif /* SWEET_T290 */
 
 #ifndef ASSEMBLER
 #define PLATFORM_PANIC_LOG_DISABLED
@@ -47,7 +63,12 @@
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
  * (CNTV) is INTID 16 + 3 = 19.
  */
+#if SWEET_T290
+/* SDM429 (msm8937.dtsi timer: <1 2>, <1 3>, <1 4>, <1 1>): CNTV is PPI 4 = INTID 20. */
+#define SWEET_VTIMER_INTID        20
+#else
 #define SWEET_VTIMER_INTID        19
+#endif
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
@@ -80,4 +101,26 @@
 #define ICC_SRE_SRE                             0x1
 /* End of GICv3 register definitions */
 
+#if HAS_GIC_V2
+/*
+ * GICv2 (Arm IHI 0048B), non-secure view: Linux on SDM429 only sets the enable
+ * bit 0 of GICD_CTLR and GICC_CTLR, groups belong to the secure firmware. On
+ * QEMU virt (no security extensions) bit 0 enables Group 0, signalled as IRQ.
+ */
+#define GICD_ISENABLER0                         0x100
+#define GICD_IPRIORITYR0                        0x400
+#define GICD_ITARGETSR0                         0x800
+#define GICD_SGIR                               0xF00
+#define GICD_SGIR_TARGET_SHIFT                  16
+
+#define GICC_CTLR                               0x00
+#define GICC_PMR                                0x04
+#define GICC_BPR                                0x08
+#define GICC_IAR                                0x0C
+#define GICC_EOIR                               0x10
+#define GICC_CTLR_ENABLE                        0x1
+#define GICC_CTLR_EOIMODENS                     0x200
+#define GICC_IAR_INTID_MASK                     0x3FF
+#endif /* HAS_GIC_V2 */
+
 #endif /* ! _PEXPERT_ARM64_SWEET_H */
