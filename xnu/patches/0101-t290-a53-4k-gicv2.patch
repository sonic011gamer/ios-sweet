+	uint32_t intid = (uint32_t)(iar & GICC_IAR_INTID_MASK);
+#else
+#define SWEET_GIC_EOI(v) __builtin_arm_wsr64("ICC_EOIR1_EL1", (v))
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
