 		/* Ack before handling so an IPI raised meanwhile is not lost */
-		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		SWEET_GIC_EOI(iar);
 		__builtin_arm_isb(ISB_SY);
 		cpu_signal_handler();
 	} else {
@@ -1888,9 +1896,10 @@ sleh_irq(arm_saved_state_t *state)
 			    cdp->interrupt_nub,
 			    intid);
 		}
-		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		SWEET_GIC_EOI(iar);
 	}
 	__builtin_arm_isb(ISB_SY);
+#undef SWEET_GIC_EOI
