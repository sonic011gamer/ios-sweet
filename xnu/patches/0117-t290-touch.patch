+/*
+ * Other T290 drivers (touch) switch RPM LDOs through the channel this
+ * driver opened: sweet_t290_rpm_ldo(5, 1800000). 0 or errno.
+ */
+int sweet_t290_rpm_ldo(uint32_t id, uint32_t uv);
+
+int
+sweet_t290_rpm_ldo(uint32_t id, uint32_t uv)
+{
+	const uint32_t kv[] = { RPM_KEY_UV, uv, RPM_KEY_SWEN, 1 };
+	if (!sd.ready || !sd.smd_tx) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_sdhc_lock);
+	uint32_t got = rpm_req(RPM_LDOA, id, kv, 2);
+	lck_mtx_unlock(&sweet_sdhc_lock);
+	return got ? 0 : EIO;
+}
+
